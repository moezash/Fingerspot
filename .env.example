# Copy this file to `.env.local` for local development.
# Next.js loads `.env.local` automatically (never commit secrets).

# -----------------------------------------------------------------------------
# Eldev API (required for real HTTP integrations)
# -----------------------------------------------------------------------------

# Base URL for the Eldev backend — absolute URL, no trailing slash
# Example: http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds (optional, default: 30000)
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Fingerspot Cloud API — integration credentials
# Configure these in Settings → Integration or set them here for local dev.
# -----------------------------------------------------------------------------

# Base URL for the Fingerspot Cloud API — no trailing slash
# Example: https://developer.fingerspot.io/api
NEXT_PUBLIC_FP_BASE_URL=

# Bearer token for Fingerspot API authentication
NEXT_PUBLIC_FP_API_TOKEN=

# -----------------------------------------------------------------------------
# Fingerspot device defaults (device-level, not integration-level)
# cloud_id belongs to individual devices. This value is used as a fallback
# default in module services when no device-specific cloud_id is available.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_FP_CLOUD_ID=
